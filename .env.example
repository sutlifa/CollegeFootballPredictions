# Postgres connection string. A pooled endpoint (Neon/PgBouncer) is fine --
# lib/db.ts sets prepare:false, which a transaction pooler requires.
DATABASE_URL=

# Free key: https://collegefootballdata.com/key
CFBD_API_KEY=

# Auth.js v5 reads these by convention -- they are not referenced in code.
# AUTH_SECRET: openssl rand -base64 32
# AUTH_GOOGLE_*: Google Cloud console -> Credentials -> OAuth 2.0 Client ID.
# Authorized redirect URI: <origin>/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Any random string. Sent as the x-admin-secret header to the schedule seeder.
ADMIN_SECRET=

# Any random string. Validates the Authorization header Vercel attaches to cron.
CRON_SECRET=

# Optional. Set to "elo" to switch on the alternative ranking model in
# lib/eloRankings.ts. Leave unset -- see that file for why it is not used.
RANKING_MODEL=

# --- Weekly pick reminders (optional; off unless BOTH are set) -------------
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Must be exactly "true" before a single mail is sent. A key on its own is
# not enough -- that is deliberate, so pasting one in to "see if it works"
# cannot mail everybody in the database.
EMAIL_REMINDERS_ENABLED=
# From address. Resend's onboarding@resend.dev works without a domain, but
# only delivers to the address that owns the Resend account -- verify a
# domain before mailing anyone else.
EMAIL_FROM=
# Absolute URL used for links in the mail. Falls back to Vercel's
# production URL, then localhost.
APP_URL=
